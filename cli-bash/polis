# Normalize a tag name: lowercase, trim, hyphens only, 1-64 chars
normalize_tag_name() {
    local name="$1"
    name=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr ' _' '--' | sed 's/[^a-z0-9-]//g')
    # Collapse multiple hyphens
    name=$(echo "$name" | sed 's/--*/-/g')
    # Trim leading/trailing hyphens
    name=$(echo "$name" | sed 's/^-//;s/-$//')
    # Truncate to 64 chars
    name=$(echo "$name" | cut -c1-64 | sed 's/-$//')
    echo "$name"
}

# Return the path to a tag file
tag_path() {
    local tag_name="$1"
    echo "content/pub.polis.core/tag/${tag_name}.json"
}

# Build canonical JSON for signing (excludes signature and current_version)
tag_canonical_json() {
    local file="$1"
    jq -c '{tag, targets, created, updated, generator}' "$file"
}

# Sign a tag file and write it back
sign_tag_file() {
    local file="$1"
    local keyfile="$2"

    # Build canonical JSON
    local canonical
    canonical=$(tag_canonical_json "$file")

    # Compute SHA-256 hash for version
    local hash
    hash=$(printf '%s' "$canonical" | sha256sum | awk '{print $1}')

    # Sign canonical content
    local temp_file=$(mktemp)
    printf '%s' "$canonical" > "$temp_file"

    ssh-keygen -Y sign -f "$keyfile" -n file "$temp_file" > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        rm -f "$temp_file" "$temp_file.sig"
        return 1
    fi

    local signature
    signature=$(cat "$temp_file.sig")
    rm -f "$temp_file" "$temp_file.sig"

    # Update file with version and signature
    local updated
    updated=$(jq --arg ver "sha256:$hash" --arg sig "$signature" \
        '.current_version = $ver | .signature = $sig' "$file")
    printf '%s\n' "$updated" | jq '.' > "$file"
}

cmd_tag() {
    if [ $# -lt 1 ]; then
        echo "Usage: polis tag <subcommand> [options]"
        echo ""
        echo "Subcommands:"
        echo "  list                          List all tags"
        echo "  show <name>                   Show targets for a tag"
        echo "  apply <name> <target-uri>     Tag content"
        echo "  remove <name> <target-uri>    Remove target from tag"
        echo "  delete <name>                 Delete entire tag"
        exit 1
    fi

    local subcmd="$1"
    shift

    case "$subcmd" in
        list)   cmd_tag_list "$@" ;;
        show)   cmd_tag_show "$@" ;;
        apply)  cmd_tag_apply "$@" ;;
        remove) cmd_tag_remove "$@" ;;
        delete) cmd_tag_delete "$@" ;;
        *)
            if [ "$JSON_MODE" = true ]; then
                json_error "tag" "UNKNOWN_SUBCOMMAND" "Unknown tag subcommand: $subcmd"
            else
                error "Unknown tag subcommand: $subcmd"
            fi
            ;;
    esac
}

cmd_tag_list() {
    local tag_dir="content/pub.polis.core/tag"

    if [ ! -d "$tag_dir" ]; then
        if [ "$JSON_MODE" = true ]; then
            json_success "tag" '{"tags":[],"count":0}'
        else
            info "No tags found"
        fi
        return 0
    fi

    local tags=()
    local tag_data='[]'

    for file in "$tag_dir"/*.json; do
        [ -f "$file" ] || continue
        local tag_name
        tag_name=$(jq -r '.tag' "$file" 2>/dev/null) || continue
        local count
        count=$(jq '.targets | length' "$file" 2>/dev/null) || continue
        local updated
        updated=$(jq -r '.updated // ""' "$file" 2>/dev/null)

        tags+=("$tag_name:$count")
        tag_data=$(echo "$tag_data" | jq --arg t "$tag_name" --argjson c "$count" --arg u "$updated" \
            '. + [{"tag": $t, "count": $c, "updated": $u}]')
    done

    if [ "$JSON_MODE" = true ]; then
        local total=${#tags[@]}
        json_success "tag" "$(jq -n --argjson tags "$tag_data" --argjson count "$total" \
            '{tags: $tags, count: $count}')"
    else
        if [ ${#tags[@]} -eq 0 ]; then
            info "No tags found"
        else
            for t in "${tags[@]}"; do
                local name="${t%%:*}"
                local count="${t##*:}"
                echo "  $name ($count targets)"
            done
        fi
    fi
}

cmd_tag_show() {
    if [ $# -lt 1 ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "MISSING_ARG" "Usage: polis tag show <name>"
        else
            error "Usage: polis tag show <name>"
        fi
    fi

    local name
    name=$(normalize_tag_name "$1")
    if [ -z "$name" ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "INVALID_NAME" "Invalid tag name"
        else
            error "Invalid tag name"
        fi
    fi

    local file
    file=$(tag_path "$name")
    if [ ! -f "$file" ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "NOT_FOUND" "Tag '$name' not found"
        else
            error "Tag '$name' not found"
        fi
    fi

    if [ "$JSON_MODE" = true ]; then
        local data
        data=$(jq '{tag: .tag, targets: .targets, count: (.targets | length)}' "$file")
        json_success "tag" "$data"
    else
        local count
        count=$(jq '.targets | length' "$file")
        info "Tag: $name ($count targets)"
        jq -r '.targets[] | "  \(.uri) (added \(.added))"' "$file"
    fi
}

cmd_tag_apply() {
    if [ $# -lt 2 ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "MISSING_ARG" "Usage: polis tag apply <name> <target-uri>"
        else
            error "Usage: polis tag apply <name> <target-uri>"
        fi
    fi

    local name
    name=$(normalize_tag_name "$1")
    local target_uri="$2"

    if [ -z "$name" ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "INVALID_NAME" "Invalid tag name"
        else
            error "Invalid tag name"
        fi
    fi

    if [ -z "$target_uri" ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "MISSING_TARGET" "Target URI is required"
        else
            error "Target URI is required"
        fi
    fi

    local file
    file=$(tag_path "$name")
    local now
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local keyfile=".polis/keys/id_ed25519"

    if [ ! -f "$keyfile" ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "NO_KEY" "Private key not found"
        else
            error "Private key not found at $keyfile"
        fi
    fi

    # Ensure tag directory exists
    mkdir -p "$(dirname "$file")"

    if [ -f "$file" ]; then
        # Check for duplicate
        local existing
        existing=$(jq -r --arg uri "$target_uri" '.targets[] | select(.uri == $uri) | .uri' "$file" 2>/dev/null)
        if [ -n "$existing" ]; then
            local count
            count=$(jq '.targets | length' "$file")
            if [ "$JSON_MODE" = true ]; then
                json_success "tag" "$(jq -n --arg t "$name" --arg u "$target_uri" --argjson c "$count" \
                    '{tag: $t, target_uri: $u, count: $c}')"
            else
                info "Target already tagged with '$name'"
            fi
            return 0
        fi

        # Add target to existing tag
        jq --arg uri "$target_uri" --arg added "$now" --arg updated "$now" --arg gen "polis-cli/$VERSION" \
            '.targets += [{"uri": $uri, "added": $added}] | .updated = $updated | .generator = $gen' \
            "$file" > "$file.tmp" && mv "$file.tmp" "$file"
    else
        # Create new tag file
        jq -n --arg tag "$name" --arg uri "$target_uri" --arg now "$now" --arg gen "polis-cli/$VERSION" \
            '{tag: $tag, targets: [{"uri": $uri, "added": $now}], created: $now, updated: $now, generator: $gen}' \
            > "$file"
    fi

    # Sign
    sign_tag_file "$file" "$keyfile"

    local count
    count=$(jq '.targets | length' "$file")

    if [ "$JSON_MODE" = true ]; then
        json_success "tag" "$(jq -n --arg t "$name" --arg u "$target_uri" --argjson c "$count" \
            '{tag: $t, target_uri: $u, count: $c}')"
    else
        success "Tagged $target_uri with '$name' ($count targets)"
    fi
}

cmd_tag_remove() {
    if [ $# -lt 2 ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "MISSING_ARG" "Usage: polis tag remove <name> <target-uri>"
        else
            error "Usage: polis tag remove <name> <target-uri>"
        fi
    fi

    local name
    name=$(normalize_tag_name "$1")
    local target_uri="$2"

    local file
    file=$(tag_path "$name")
    local keyfile=".polis/keys/id_ed25519"

    if [ ! -f "$file" ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "NOT_FOUND" "Tag '$name' not found"
        else
            error "Tag '$name' not found"
        fi
    fi

    # Check target exists
    local existing
    existing=$(jq -r --arg uri "$target_uri" '.targets[] | select(.uri == $uri) | .uri' "$file" 2>/dev/null)
    if [ -z "$existing" ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "TARGET_NOT_FOUND" "Target '$target_uri' not found in tag '$name'"
        else
            error "Target '$target_uri' not found in tag '$name'"
        fi
    fi

    local now
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    # Remove target
    jq --arg uri "$target_uri" --arg updated "$now" --arg gen "polis-cli/$VERSION" \
        '.targets = [.targets[] | select(.uri != $uri)] | .updated = $updated | .generator = $gen' \
        "$file" > "$file.tmp" && mv "$file.tmp" "$file"

    # Re-sign
    sign_tag_file "$file" "$keyfile"

    local count
    count=$(jq '.targets | length' "$file")

    if [ "$JSON_MODE" = true ]; then
        json_success "tag" "$(jq -n --arg t "$name" --arg u "$target_uri" --argjson c "$count" \
            '{tag: $t, target_uri: $u, count: $c}')"
    else
        success "Removed $target_uri from '$name' ($count targets remaining)"
    fi
}

cmd_tag_delete() {
    if [ $# -lt 1 ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "MISSING_ARG" "Usage: polis tag delete <name>"
        else
            error "Usage: polis tag delete <name>"
        fi
    fi

    local name
    name=$(normalize_tag_name "$1")

    local file
    file=$(tag_path "$name")

    if [ ! -f "$file" ]; then
        if [ "$JSON_MODE" = true ]; then
            json_error "tag" "NOT_FOUND" "Tag '$name' not found"
        else
            error "Tag '$name' not found"
        fi
    fi

    rm -f "$file"

    if [ "$JSON_MODE" = true ]; then
        json_success "tag" "$(jq -n --arg t "$name" '{tag: $t, deleted: true}')"
    else
        success "Deleted tag '$name'"
    fi
}

# Render blessed comments for a post
# Returns HTML string via stdout; stdout is captured by caller
render_blessed_comments() {
    local post_url="$1"
    local blessed_html=""
    local count=0

    # Check if blessed-comments.json exists
    if [ ! -f "$BLESSED_COMMENTS" ]; then
        echo ""
        return
    fi

    # Get blessed comments for this post
    # Use -c for compact output (one JSON object per line)
    # Try both .md and .html extensions since blessed-comments.json might have either
    local comments_json
    local post_url_md="${post_url%.html}.md"
    local post_url_html="${post_url%.md}.html"
    comments_json=$(jq -c --arg url "$post_url" --arg url_md "$post_url_md" --arg url_html "$post_url_html" \
        '.comments[] | select(.post == $url or .post == $url_md or .post == $url_html) | .blessed[]' "$BLESSED_COMMENTS" 2>/dev/null)

    if [ -z "$comments_json" ]; then
        echo ""
        return
    fi

    # Process each blessed comment (one JSON object per line)
    while IFS= read -r comment_data; do
        [ -z "$comment_data" ] && continue

        local comment_url=$(echo "$comment_data" | jq -r '.url // empty')
        [ -z "$comment_url" ] && continue

        # Try to fetch/find the comment content
        local comment_content=""
        local comment_file=""

        # Check if it's a local comment (same domain)
        local base_url="${POLIS_BASE_URL%/}"  # Remove trailing slash
        if [[ "$comment_url" == "${base_url}"* ]]; then
            # Extract path from URL and find local file
            local url_path="${comment_url#${base_url}}"
            url_path="${url_path#/}"  # Remove leading slash(es)
            url_path="${url_path#/}"  # Handle double slash case
            if [ -f "$url_path" ]; then
                comment_file="$url_path"
                comment_content=$(cat "$comment_file")
            fi
        fi

        # If not found locally, try to fetch remotely
        if [ -z "$comment_content" ]; then
            comment_content=$(curl -sL "$comment_url" 2>/dev/null)
        fi

        # If we found content, render it
        if [ -n "$comment_content" ]; then
            local c_title=$(echo "$comment_content" | grep '^title:' | head -1 | sed 's/^title: *//')
            local c_published=$(echo "$comment_content" | grep '^published:' | head -1 | sed 's/^published: *//')
            local c_body=$(extract_body_from_content "$comment_content")
            # Strip leading blank lines
            c_body=$(echo "$c_body" | sed '/./,$!d')
            local c_html=$(echo "$c_body" | pandoc -f markdown -t html 2>/dev/null || echo "$c_body")

            # Get author info from URL
            local author_domain=$(echo "$comment_url" | sed 's|https\?://||' | cut -d'/' -f1)
            local author_name="$author_domain"

            # Try to get site_title from author's .well-known/polis
            if [[ "$comment_url" == "${base_url}"* ]]; then
                # Local comment - use our .well-known/polis
                if [ -f "$WELL_KNOWN_DIR/polis" ]; then
                    local local_title=$(jq -r '.site_title // empty' "$WELL_KNOWN_DIR/polis" 2>/dev/null)
                    [ -n "$local_title" ] && author_name="$local_title"
                fi
            else
                # Remote comment - try to fetch their .well-known/polis
                local remote_polis=$(curl -sL "https://$author_domain/.well-known/polis" 2>/dev/null)
                if [ -n "$remote_polis" ]; then
                    local remote_title=$(echo "$remote_polis" | jq -r '.site_title // empty' 2>/dev/null)
                    [ -n "$remote_title" ] && author_name="$remote_title"
                fi
            fi

            declare -A comment_vars=(
                [author_name]="$author_name"
                [author_url]="https://$author_domain"
                [published]="$c_published"
                [published_human]="$(format_date_human "$c_published")"
                [content]="$c_html"
                [url]="$comment_url"
            )

            local comment_html="${TEMPLATES[comment_inline]}"
            for key in "${!comment_vars[@]}"; do
                local escaped_val=$(escape_for_replacement "${comment_vars[$key]}")
                comment_html="${comment_html//\{\{$key\}\}/$escaped_val}"
            done

            blessed_html+="$comment_html"
            ((++count))  # Pre-increment to avoid set -e exit when count=0
        fi
    done <<< "$comments_json"

    echo "$blessed_html"
}

# Resolve a snippet path within a specific directory
# Arguments:
#   $1 - directory to search in
#   $2 - snippet path (e.g., "about" or "about.md")
#   $3 - whether path has explicit extension (true/false)
# Returns: full path to resolved file, or empty string
resolve_snippet_in_dir() {
    local dir="$1"
    local path="$2"
    local explicit_ext="$3"

    [ ! -d "$dir" ] && return

    if [ "$explicit_ext" = true ]; then
        # Explicit extension: only check exact path
        [ -f "$dir/$path" ] && echo "$dir/$path"
    else
        # No extension: try .md -> .html -> exact
        if [ -f "$dir/$path.md" ]; then
            echo "$dir/$path.md"
        elif [ -f "$dir/$path.html" ]; then
            echo "$dir/$path.html"
        elif [ -f "$dir/$path" ]; then
            echo "$dir/$path"
        fi
    fi
}

# Load a snippet by path and render it
# Returns rendered HTML content
# Lookup order: global snippets -> theme snippets (author overrides theme)
# Supports:
#   {{> about}}           - Default: global first, then theme
#   {{> global:about}}    - Explicit global-first (same as default)
#   {{> theme:about}}     - Theme-first, then global fallback
#   {{> about.md}}        - Explicit extension, no fallback
#   {{> theme:about.html}} - Combined prefix and extension
load_snippet() {
    local snippet_path="$1"
    local context="$2"  # Optional JSON context for variable substitution

    # Parse tier prefix (global: or theme:)
    local tier_mode="global_first"  # default
    local base_path="$snippet_path"

    if [[ "$snippet_path" == global:* ]]; then
        tier_mode="global_first"
        base_path="${snippet_path#global:}"
    elif [[ "$snippet_path" == theme:* ]]; then
        tier_mode="theme_first"
        base_path="${snippet_path#theme:}"
    fi

    # Check for explicit extension (.md or .html)
    local has_explicit_extension=false
    if [[ "$base_path" == *.md ]] || [[ "$base_path" == *.html ]]; then
        has_explicit_extension=true
    fi

    local snippet_file=""
    local theme_snippets_dir="$THEMES_DIR/$ACTIVE_THEME/snippets"

    # Resolve based on tier mode
    if [ "$tier_mode" = "theme_first" ]; then
        # Theme-first: check theme snippets, then global
        if [ -n "$ACTIVE_THEME" ] && [ -d "$theme_snippets_dir" ]; then
            snippet_file=$(resolve_snippet_in_dir "$theme_snippets_dir" "$base_path" "$has_explicit_extension")
        fi
        [ -z "$snippet_file" ] && snippet_file=$(resolve_snippet_in_dir "$SNIPPETS_DIR" "$base_path" "$has_explicit_extension")
    else
        # Global-first (default): check global snippets, then theme
        snippet_file=$(resolve_snippet_in_dir "$SNIPPETS_DIR" "$base_path" "$has_explicit_extension")
        if [ -z "$snippet_file" ] && [ -n "$ACTIVE_THEME" ] && [ -d "$theme_snippets_dir" ]; then
            snippet_file=$(resolve_snippet_in_dir "$theme_snippets_dir" "$base_path" "$has_explicit_extension")
        fi
    fi

    local content=""

    # Debug: show snippet lookup result (redirect to stderr so it doesn't get captured in output)
    if [ -n "$snippet_file" ]; then
        info_human "  Snippet '$snippet_path' -> $snippet_file ($tier_mode)" >&2
    else
        warn "Snippet '$snippet_path' not found ($tier_mode, searched: $SNIPPETS_DIR, $theme_snippets_dir)" >&2
    fi

    if [ -n "$snippet_file" ] && [ -f "$snippet_file" ]; then
        # Extract content without frontmatter
        if has_frontmatter "$snippet_file"; then
            content=$(extract_content_without_frontmatter "$snippet_file")
        else
            content=$(cat "$snippet_file")
        fi

        # Process based on file extension
        if [[ "$snippet_file" == *.md ]]; then
            # Remove leading blank lines, render markdown to HTML
            content=$(echo "$content" | sed '/./,$!d')
            local pandoc_output
            if pandoc_output=$(echo "$content" | pandoc -f markdown -t html 2>&1); then
                content="$pandoc_output"
            else
                warn "Failed to render snippet '$snippet_path': $pandoc_output" >&2
                content=""
            fi
        fi
        # .html files are used as-is
    fi
    # If no snippet found, content is empty

    echo "$content"
}

# Resolve snippet path and return the file path (for marker generation)
# Uses same logic as load_snippet but only returns the path
# Arguments:
#   $1 - Snippet path (e.g., "about", "theme:header", "footer.html")
# Outputs: <source>:<file_path> where source is "global", "theme", or "notfound"
resolve_snippet_path() {
    local snippet_path="$1"

    # Parse tier prefix (global: or theme:)
    local tier_mode="global_first"
    local base_path="$snippet_path"

    if [[ "$snippet_path" == global:* ]]; then
        tier_mode="global_first"
        base_path="${snippet_path#global:}"
    elif [[ "$snippet_path" == theme:* ]]; then
        tier_mode="theme_first"
        base_path="${snippet_path#theme:}"
    fi

    # Check for explicit extension (.md or .html)
    local has_explicit_extension=false
    if [[ "$base_path" == *.md ]] || [[ "$base_path" == *.html ]]; then
        has_explicit_extension=true
    fi

    local snippet_file=""
    local source="notfound"
    local theme_snippets_dir="$THEMES_DIR/$ACTIVE_THEME/snippets"

    # Resolve based on tier mode
    if [ "$tier_mode" = "theme_first" ]; then
        # Theme-first: check theme snippets, then global
        if [ -n "$ACTIVE_THEME" ] && [ -d "$theme_snippets_dir" ]; then
            snippet_file=$(resolve_snippet_in_dir "$theme_snippets_dir" "$base_path" "$has_explicit_extension")
            [ -n "$snippet_file" ] && source="theme"
        fi
        if [ -z "$snippet_file" ]; then
            snippet_file=$(resolve_snippet_in_dir "$SNIPPETS_DIR" "$base_path" "$has_explicit_extension")
            [ -n "$snippet_file" ] && source="global"
        fi
    else
        # Global-first (default): check global snippets, then theme
        snippet_file=$(resolve_snippet_in_dir "$SNIPPETS_DIR" "$base_path" "$has_explicit_extension")
        [ -n "$snippet_file" ] && source="global"
        if [ -z "$snippet_file" ] && [ -n "$ACTIVE_THEME" ] && [ -d "$theme_snippets_dir" ]; then
            snippet_file=$(resolve_snippet_in_dir "$theme_snippets_dir" "$base_path" "$has_explicit_extension")
            [ -n "$snippet_file" ] && source="theme"
        fi
    fi

    echo "${source}:${snippet_file}"
}

# Render all {{> path}} partial includes in content
# Recursively processes snippets that include other snippets
# When RENDER_MARKERS=true, wraps snippet content with HTML markers for browser editing
# Arguments:
#   $1 - Content containing {{> path}} patterns
#   $2 - Optional context JSON for variable substitution
#   $3 - Depth counter (for recursion limit)
render_partials() {
    local content="$1"
    local context="${2:-}"
    local depth="${3:-0}"

    # Prevent infinite recursion
    if [ "$depth" -gt 10 ]; then
        warn "Maximum snippet nesting depth (10) exceeded"
        echo "$content"
        return
    fi

    # Find all {{> path}} patterns and replace them
    # Pattern: {{> some/path}} or {{> some/path.html}}
    local result="$content"
    local pattern='\{\{>\s*([^}]+)\s*\}\}'

    # Debug: check if any partials exist in content (redirect to stderr)
    if echo "$content" | grep -q '{{>'; then
        info_human "  render_partials: found {{> patterns in content (depth=$depth)" >&2
    fi

    # Use grep to find all matches, process each one
    while [[ "$result" =~ $pattern ]]; do
        local full_match="${BASH_REMATCH[0]}"
        local snippet_path="${BASH_REMATCH[1]}"

        # Trim whitespace from path
        snippet_path=$(echo "$snippet_path" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

        # Resolve snippet path to get source and file location
        local resolved
        resolved=$(resolve_snippet_path "$snippet_path")
        local snippet_source="${resolved%%:*}"
        local snippet_file="${resolved#*:}"

        # Extract base path (strip tier prefix like "theme:" or "global:" if present)
        local base_path="$snippet_path"
        if [[ "$snippet_path" == global:* ]]; then
            base_path="${snippet_path#global:}"
        elif [[ "$snippet_path" == theme:* ]]; then
            base_path="${snippet_path#theme:}"
        fi

        # Load and render the snippet
        local snippet_content
        snippet_content=$(load_snippet "$snippet_path" "$context")

        # Recursively render any partials in the loaded snippet
        if [ -n "$snippet_content" ]; then
            snippet_content=$(render_partials "$snippet_content" "$context" $((depth + 1)))
        fi

        # Wrap with markers if enabled and snippet was found
        if [ "$RENDER_MARKERS" = true ] && [ "$snippet_source" != "notfound" ] && [ -n "$snippet_content" ]; then
            # Create a unique identifier combining source and base path (without tier prefix)
            local marker_id="${snippet_source}:${base_path}"
            # Build the marked content with HTML comments and hidden span for DOM anchoring
            snippet_content="<!-- POLIS-SNIPPET-START: ${marker_id} path=${base_path} -->
<span class=\"polis-snippet-boundary\" data-snippet=\"${marker_id}\" data-path=\"${base_path}\" data-source=\"${snippet_source}\" hidden></span>
${snippet_content}
<!-- POLIS-SNIPPET-END: ${marker_id} -->"
        fi

        # Escape the snippet content for bash replacement
        local escaped_snippet
        escaped_snippet=$(escape_for_replacement "$snippet_content")

        # Replace the first occurrence of this partial
        result="${result//"$full_match"/$escaped_snippet}"
    done

    echo "$result"
}

# Render {{#section}}...{{/section}} loop blocks
# Supports: {{#posts}}, {{#comments}}, {{#blessed_comments}}
# Arguments:
#   $1 - Content containing section blocks
#   $2 - Optional context (e.g., post URL for blessed_comments)
render_sections() {
    local content="$1"
    local context="${2:-}"
    local result="$content"

    # Process {{#posts}}...{{/posts}} blocks
    if echo "$result" | grep -q '{{#posts}}'; then
        # Extract inner template using perl (handles multiline)
        local inner_template
        inner_template=$(echo "$result" | perl -0777 -ne 'print $1 if /\{\{#posts\}\}(.*?)\{\{\/posts\}\}/s')
        local posts_html=""

        if [ -f "$PUBLIC_INDEX" ]; then
            local sorted_posts
            sorted_posts=$(jq -s '[.[] | select(.type == "post" or .type == null)] | sort_by(.published) | reverse' "$PUBLIC_INDEX" 2>/dev/null)

            local num_posts
            num_posts=$(echo "$sorted_posts" | jq 'length')

            for ((i=0; i<num_posts; i++)); do
                local path=$(echo "$sorted_posts" | jq -r ".[$i].path // empty")
                local title=$(echo "$sorted_posts" | jq -r ".[$i].title // \"Untitled\"")
                local published=$(echo "$sorted_posts" | jq -r ".[$i].published // empty")

                [ -z "$path" ] && continue

                local url="${path%.md}.html"
                local published_human=$(format_date_human "$published")

                # Count blessed comments for this post
                local comment_count=0
                if [ -f "$BLESSED_COMMENTS" ]; then
                    local post_url_html="${POLIS_BASE_URL%/}/$url"
                    local post_url_md="${post_url_html%.html}.md"
                    comment_count=$(jq --arg url_html "$post_url_html" --arg url_md "$post_url_md" \
                        '[.comments[] | select(.post == $url_html or .post == $url_md) | .blessed[]] | length' \
                        "$BLESSED_COMMENTS" 2>/dev/null) || comment_count=0
                fi

                # Render inner template with item variables
                local item_html="$inner_template"

                # Process any partials in the inner template
                item_html=$(render_partials "$item_html")

                # Substitute item-level variables
                item_html="${item_html//\{\{url\}\}/$(escape_for_replacement "$url")}"
                item_html="${item_html//\{\{title\}\}/$(escape_for_replacement "$title")}"
                item_html="${item_html//\{\{published\}\}/$(escape_for_replacement "$published")}"
                item_html="${item_html//\{\{published_human\}\}/$(escape_for_replacement "$published_human")}"
                item_html="${item_html//\{\{comment_count\}\}/$(escape_for_replacement "$comment_count")}"

                posts_html+="$item_html"
            done
        fi

        # Replace the entire section with rendered posts (use temp file to avoid escaping issues)
        local tmp_replacement=$(mktemp)
        echo -n "$posts_html" > "$tmp_replacement"
        result=$(echo "$result" | perl -0777 -pe '
            BEGIN { local $/; open my $fh, "<", "'"$tmp_replacement"'"; $repl = <$fh>; close $fh; }
            s/\{\{#posts\}\}.*?\{\{\/posts\}\}/$repl/s;
        ')
        rm -f "$tmp_replacement"
    fi

    # Process {{#comments}}...{{/comments}} blocks (outgoing comments)
    if echo "$result" | grep -q '{{#comments}}'; then
        # Extract inner template using perl (handles multiline)
        local inner_template
        inner_template=$(echo "$result" | perl -0777 -ne 'print $1 if /\{\{#comments\}\}(.*?)\{\{\/comments\}\}/s')
        local comments_html=""

        if [ -f "$PUBLIC_INDEX" ]; then
            local sorted_comments
            sorted_comments=$(jq -s '[.[] | select(.type == "comment")] | sort_by(.published) | reverse' "$PUBLIC_INDEX" 2>/dev/null)

            local num_comments
            num_comments=$(echo "$sorted_comments" | jq 'length')

            for ((i=0; i<num_comments; i++)); do
                local path=$(echo "$sorted_comments" | jq -r ".[$i].path // empty")
                local published=$(echo "$sorted_comments" | jq -r ".[$i].published // empty")
                # in_reply_to may be a string URL or an object with .url field
                local in_reply_to=$(echo "$sorted_comments" | jq -r "(.[$i].in_reply_to | if type == \"object\" then .url else . end) // empty")

                [ -z "$path" ] && continue

                local url="${path%.md}.html"
                local published_human=$(format_date_human "$published")

                # Extract target author from in_reply_to URL
                local target_author=""
                if [ -n "$in_reply_to" ]; then
                    target_author=$(echo "$in_reply_to" | sed -E 's|https?://([^/]+).*|\1|')
                fi

                # Get preview from file body
                local preview=""
                if [ -f "$path" ]; then
                    preview=$(extract_body_from_file "$path" | head -c 100 | tr '\n' ' ')
                    [ ${#preview} -ge 100 ] && preview="${preview}..."
                fi

                # Render inner template with item variables
                local item_html="$inner_template"

                # Process any partials in the inner template
                item_html=$(render_partials "$item_html")

                # Substitute item-level variables
                item_html="${item_html//\{\{url\}\}/$(escape_for_replacement "$url")}"
                item_html="${item_html//\{\{published\}\}/$(escape_for_replacement "$published")}"
                item_html="${item_html//\{\{published_human\}\}/$(escape_for_replacement "$published_human")}"
                item_html="${item_html//\{\{target_author\}\}/$(escape_for_replacement "$target_author")}"
                item_html="${item_html//\{\{preview\}\}/$(escape_for_replacement "$preview")}"

                comments_html+="$item_html"
            done
        fi

        # Replace the entire section with rendered comments (use temp file to avoid escaping issues)
        local tmp_replacement=$(mktemp)
        echo -n "$comments_html" > "$tmp_replacement"
        result=$(echo "$result" | perl -0777 -pe '
            BEGIN { local $/; open my $fh, "<", "'"$tmp_replacement"'"; $repl = <$fh>; close $fh; }
            s/\{\{#comments\}\}.*?\{\{\/comments\}\}/$repl/s;
        ')
        rm -f "$tmp_replacement"
    fi

    # Process {{#blessed_comments}}...{{/blessed_comments}} blocks
    if echo "$result" | grep -q '{{#blessed_comments}}'; then
        # Extract inner template using perl (handles multiline)
        local inner_template
        inner_template=$(echo "$result" | perl -0777 -ne 'print $1 if /\{\{#blessed_comments\}\}(.*?)\{\{\/blessed_comments\}\}/s')
        local blessed_html=""
        local post_url="$context"  # The post URL we're rendering blessed comments for

        if [ -f "$BLESSED_COMMENTS" ] && [ -n "$post_url" ]; then
            local post_url_md="${post_url%.html}.md"
            local post_url_html="${post_url%.md}.html"
            local comments_json
            comments_json=$(jq -c --arg url "$post_url" --arg url_md "$post_url_md" --arg url_html "$post_url_html" \
                '.comments[] | select(.post == $url or .post == $url_md or .post == $url_html) | .blessed[]' "$BLESSED_COMMENTS" 2>/dev/null)

            while IFS= read -r comment_entry; do
                [ -z "$comment_entry" ] && continue

                local comment_url=$(echo "$comment_entry" | jq -r '.url // empty')
                [ -z "$comment_url" ] && continue
                # Normalize any double slashes in path (but preserve ://)
                comment_url=$(echo "$comment_url" | sed 's|://\([^/]*\)//|://\1/|')

                # Fetch comment content (local or remote)
                local raw_content=""
                local base_url="${POLIS_BASE_URL%/}"
                if [[ "$comment_url" == "${base_url}"* ]]; then
                    local url_path="${comment_url#${base_url}}"
                    url_path="${url_path#/}"
                    url_path="${url_path#/}"
                    [ -f "$url_path" ] && raw_content=$(cat "$url_path")
                fi
                if [ -z "$raw_content" ]; then
                    raw_content=$(curl -sL "$comment_url" 2>/dev/null)
                fi

                # Extract metadata and body from fetched content
                local author_name=""
                local published=""
                local comment_html_content=""
                if [ -n "$raw_content" ]; then
                    published=$(echo "$raw_content" | grep '^published:' | head -1 | sed 's/^published: *//')
                    local c_body=$(extract_body_from_content "$raw_content")
                    c_body=$(echo "$c_body" | sed '/./,$!d')
                    comment_html_content=$(echo "$c_body" | pandoc -f markdown -t html 2>/dev/null || echo "$c_body")
                fi

                # Derive author from URL domain
                local author_domain=$(echo "$comment_url" | sed 's|https\?://||' | cut -d'/' -f1)
                author_name="$author_domain"

                # Try to get author's site_title from their .well-known/polis
                local remote_polis=$(curl -sL "https://$author_domain/.well-known/polis" 2>/dev/null)
                if [ -n "$remote_polis" ]; then
                    local remote_title=$(echo "$remote_polis" | jq -r '.site_title // empty' 2>/dev/null)
                    [ -n "$remote_title" ] && author_name="$remote_title"
                fi

                local published_human=$(format_date_human "$published")

                # Render inner template with item variables
                local item_html="$inner_template"
                item_html=$(render_partials "$item_html")
                item_html="${item_html//\{\{url\}\}/$(escape_for_replacement "$comment_url")}"
                item_html="${item_html//\{\{author_name\}\}/$(escape_for_replacement "$author_name")}"
                item_html="${item_html//\{\{author_url\}\}/$(escape_for_replacement "https://$author_domain")}"
                item_html="${item_html//\{\{published\}\}/$(escape_for_replacement "$published")}"
                item_html="${item_html//\{\{published_human\}\}/$(escape_for_replacement "$published_human")}"
                item_html="${item_html//\{\{content\}\}/$(escape_for_replacement "$comment_html_content")}"

                blessed_html+="$item_html"
            done <<< "$comments_json"
        fi

        # Replace the entire section with rendered blessed comments (use temp file to avoid escaping issues)
        local tmp_replacement=$(mktemp)
        echo -n "$blessed_html" > "$tmp_replacement"
        result=$(echo "$result" | perl -0777 -pe '
            BEGIN { local $/; open my $fh, "<", "'"$tmp_replacement"'"; $repl = <$fh>; close $fh; }
            s/\{\{#blessed_comments\}\}.*?\{\{\/blessed_comments\}\}/$repl/s;
        ')
        rm -f "$tmp_replacement"
    fi

    # Process {{#recent_posts}}...{{/recent_posts}} blocks
    # Shows up to 10 recent posts, excluding the current post (identified by context URL)
    if echo "$result" | grep -q '{{#recent_posts}}'; then
        local inner_template
        inner_template=$(echo "$result" | perl -0777 -ne 'print $1 if /\{\{#recent_posts\}\}(.*?)\{\{\/recent_posts\}\}/s')
        local recent_html=""

        if [ -f "$PUBLIC_INDEX" ]; then
            local sorted_posts
            sorted_posts=$(jq -s '[.[] | select(.type == "post" or .type == null)] | sort_by(.published) | reverse' "$PUBLIC_INDEX" 2>/dev/null)

            local num_posts
            num_posts=$(echo "$sorted_posts" | jq 'length')

            local rendered_count=0
            for ((i=0; i<num_posts && rendered_count<10; i++)); do
                local path=$(echo "$sorted_posts" | jq -r ".[$i].path // empty")
                local title=$(echo "$sorted_posts" | jq -r ".[$i].title // \"Untitled\"")
                local published=$(echo "$sorted_posts" | jq -r ".[$i].published // empty")

                [ -z "$path" ] && continue

                local url="/${path%.md}.html"

                # Skip the current post (check if its path appears in the context URL)
                if [ -n "$context" ] && [[ "$context" == *"$path"* ]]; then
                    continue
                fi

                local published_human=$(format_date_human "$published")

                # Count blessed comments for this post
                local comment_count=0
                if [ -f "$BLESSED_COMMENTS" ]; then
                    local post_url_html="${POLIS_BASE_URL%/}/$url"
                    local post_url_md="${post_url_html%.html}.md"
                    comment_count=$(jq --arg url_html "$post_url_html" --arg url_md "$post_url_md" \
                        '[.comments[] | select(.post == $url_html or .post == $url_md) | .blessed[]] | length' \
                        "$BLESSED_COMMENTS" 2>/dev/null) || comment_count=0
                fi

                # Render inner template with item variables
                local item_html="$inner_template"
                item_html=$(render_partials "$item_html")
                item_html="${item_html//\{\{url\}\}/$(escape_for_replacement "$url")}"
                item_html="${item_html//\{\{title\}\}/$(escape_for_replacement "$title")}"
                item_html="${item_html//\{\{published\}\}/$(escape_for_replacement "$published")}"
                item_html="${item_html//\{\{published_human\}\}/$(escape_for_replacement "$published_human")}"
                item_html="${item_html//\{\{comment_count\}\}/$(escape_for_replacement "$comment_count")}"

                recent_html+="$item_html"
                ((++rendered_count))
            done
        fi

        # Replace the entire section with rendered recent posts
        local tmp_replacement=$(mktemp)
        echo -n "$recent_html" > "$tmp_replacement"
        result=$(echo "$result" | perl -0777 -pe '
            BEGIN { local $/; open my $fh, "<", "'"$tmp_replacement"'"; $repl = <$fh>; close $fh; }
            s/\{\{#recent_posts\}\}.*?\{\{\/recent_posts\}\}/$repl/s;
        ')
        rm -f "$tmp_replacement"
    fi

    # Process {{#recent_comments}}...{{/recent_comments}} blocks
    # Shows up to 10 recent comments
    if echo "$result" | grep -q '{{#recent_comments}}'; then
        local inner_template
        inner_template=$(echo "$result" | perl -0777 -ne 'print $1 if /\{\{#recent_comments\}\}(.*?)\{\{\/recent_comments\}\}/s')
        local recent_comments_html=""

        if [ -f "$PUBLIC_INDEX" ]; then
            local sorted_comments
            sorted_comments=$(jq -s '[.[] | select(.type == "comment")] | sort_by(.published) | reverse' "$PUBLIC_INDEX" 2>/dev/null)

            local num_comments
            num_comments=$(echo "$sorted_comments" | jq 'length')

            local rendered_count=0
            for ((i=0; i<num_comments && rendered_count<10; i++)); do
                local path=$(echo "$sorted_comments" | jq -r ".[$i].path // empty")
                local published=$(echo "$sorted_comments" | jq -r ".[$i].published // empty")
                local in_reply_to=$(echo "$sorted_comments" | jq -r "(.[$i].in_reply_to | if type == \"object\" then .url else . end) // empty")

                [ -z "$path" ] && continue

                local url="${path%.md}.html"
                local published_human=$(format_date_human "$published")

                # Extract target author from in_reply_to URL
                local target_author=""
                if [ -n "$in_reply_to" ]; then
                    target_author=$(echo "$in_reply_to" | sed -E 's|https?://([^/]+).*|\1|')
                fi

                # Get preview from file body
                local preview=""
                if [ -f "$path" ]; then
                    preview=$(extract_body_from_file "$path" | head -c 100 | tr '\n' ' ')
                    [ ${#preview} -ge 100 ] && preview="${preview}..."
                fi

                # Render inner template with item variables
                local item_html="$inner_template"
                item_html=$(render_partials "$item_html")
                item_html="${item_html//\{\{url\}\}/$(escape_for_replacement "$url")}"
                item_html="${item_html//\{\{published\}\}/$(escape_for_replacement "$published")}"
                item_html="${item_html//\{\{published_human\}\}/$(escape_for_replacement "$published_human")}"
                item_html="${item_html//\{\{target_author\}\}/$(escape_for_replacement "$target_author")}"
                item_html="${item_html//\{\{preview\}\}/$(escape_for_replacement "$preview")}"

                recent_comments_html+="$item_html"
                ((++rendered_count))
            done
        fi

        # Replace the entire section with rendered recent comments
        local tmp_replacement=$(mktemp)
        echo -n "$recent_comments_html" > "$tmp_replacement"
        result=$(echo "$result" | perl -0777 -pe '
            BEGIN { local $/; open my $fh, "<", "'"$tmp_replacement"'"; $repl = <$fh>; close $fh; }
            s/\{\{#recent_comments\}\}.*?\{\{\/recent_comments\}\}/$repl/s;
        ')
        rm -f "$tmp_replacement"
    fi

    echo "$result"
}

# Render a single file to HTML
render_file() {
    local input_file="$1"
    local type="$2"  # "post" or "comment"
    local force="$3"

    # Compute mount-dir output path (source/output separation)
    local suffix=""
    local mount_dir=""
    local output_file=""
    local output_md=""
    if [ "$type" = "post" ] && [ -n "$POSTS_MOUNT_DIR" ]; then
        suffix="${input_file#$POSTS_DIR/}"
        mount_dir="$POSTS_MOUNT_DIR"
    elif [ "$type" = "comment" ] && [ -n "$COMMENTS_MOUNT_DIR" ]; then
        suffix="${input_file#$COMMENTS_DIR/}"
        mount_dir="$COMMENTS_MOUNT_DIR"
    fi

    if [ -n "$mount_dir" ] && [ "$suffix" != "$input_file" ]; then
        output_file="${mount_dir}/${suffix%.md}.html"
        output_md="${mount_dir}/${suffix}"
    else
        output_file="${input_file%.md}.html"
        output_md=""  # no copy needed (legacy mode)
    fi

    # Skip if output is newer than input (unless force)
    if [ "$force" != "true" ] && [ -f "$output_file" ] && [ "$output_file" -nt "$input_file" ]; then
        # Also check if blessed-comments.json is newer (new comments to render)
        if [ -f "$BLESSED_COMMENTS" ] && [ "$BLESSED_COMMENTS" -nt "$output_file" ]; then
            : # Don't skip - blessed comments may have changed
        else
            return 1  # Skipped
        fi
    fi

    # Check pandoc availability
    if ! command -v pandoc &>/dev/null; then
        error "pandoc is required for rendering. Install with: apt install pandoc (Linux) or brew install pandoc (macOS)"
    fi

    # Read file content
    local content=$(cat "$input_file")

    # Extract frontmatter fields
    local title=$(echo "$content" | grep '^title:' | head -1 | sed 's/^title: *//')
    local published=$(echo "$content" | grep '^published:' | head -1 | sed 's/^published: *//')
    local version=$(echo "$content" | grep '^current-version:' | head -1 | sed 's/^current-version: *//')
    local signature=$(echo "$content" | grep '^signature:' | head -1 | sed 's/^signature: *//')
    local signature_short="${signature:0:20}..."

    # Extract body and convert to HTML
    local body=$(extract_body_from_content "$content")
    # Strip leading blank lines
    body=$(echo "$body" | sed '/./,$!d')
    local html_content=$(echo "$body" | pandoc -f markdown -t html 2>/dev/null || echo "$body")

    # Build canonical URL using mount path (normalize to avoid double slashes)
    local base_url="${POLIS_BASE_URL%/}"  # Remove trailing slash if present
    local url_path="$output_file"  # Use mount path for URL (e.g., posts/20260101/test.html)
    local url="${base_url}/${url_path}"
    info_human "  [url] Canonical URL: $url"

    # Get site info - prefer .well-known/polis, fallback to domain
    local site_title=""
    if [ -f "$WELL_KNOWN_DIR/polis" ]; then
        site_title=$(jq -r '.site_title // empty' "$WELL_KNOWN_DIR/polis" 2>/dev/null)
    fi
    if [ -z "$site_title" ]; then
        site_title="${POLIS_BASE_URL#https://}"
        site_title="${site_title#http://}"
    fi

    # Get author info from .well-known/polis
    local author_name="$site_title"
    if [ -f "$WELL_KNOWN_DIR/polis" ]; then
        local wk_name=$(jq -r '.name // empty' "$WELL_KNOWN_DIR/polis" 2>/dev/null)
        [ -n "$wk_name" ] && author_name="$wk_name"
    fi

    # Calculate relative path to root and CSS based on output path (mount path)
    local dir_path=$(dirname "$output_file")
    local root_path=""
    local css_path=""
    local home_path=""
    if [ "$dir_path" = "." ]; then
        root_path="./"
        css_path="styles.css"
        home_path="index.html"
    else
        # Count slashes to determine depth
        local depth=$(echo "$dir_path" | tr -cd '/' | wc -c)
        depth=$((depth + 1))  # Add 1 for the directory itself
        for ((i=0; i<depth; i++)); do
            root_path+="../"
        done
        css_path="${root_path}styles.css"
        home_path="${root_path}index.html"
    fi

    # Choose template
    local template="${TEMPLATES[$type]}"
    [ -z "$template" ] && template="${TEMPLATES[post]}"

    # Handle blessed comments count (for posts and comments with replies)
    local blessed_count=0
    if [ -f "$BLESSED_COMMENTS" ]; then
        local url_md="${url%.html}.md"
        local url_html="${url%.md}.html"
        blessed_count=$(jq --arg url "$url" --arg url_md "$url_md" --arg url_html "$url_html" \
            '[.comments[] | select(.post == $url or .post == $url_md or .post == $url_html) | .blessed[]] | length' \
            "$BLESSED_COMMENTS" 2>/dev/null) || blessed_count=0
    fi

    # Comment-specific fields
    local in_reply_to_url=""
    local root_post_url=""
    if [ "$type" = "comment" ]; then
        in_reply_to_url=$(echo "$content" | grep -A1 '^in-reply-to:' | grep 'url:' | sed 's/.*url: *//')
        root_post_url=$(echo "$content" | grep -A2 '^in-reply-to:' | grep 'root-post:' | sed 's/.*root-post: *//')
    fi

    # Substitute all variables
    # Note: Values containing HTML must be escaped for bash pattern replacement
    local result="$template"

    # Process {{> partial}} includes first
    result=$(render_partials "$result")

    # Process {{#section}}...{{/section}} loops
    # Pass full post URL as context for blessed_comments and recent_posts lookup
    result=$(render_sections "$result" "$url")

    result="${result//\{\{title\}\}/$(escape_for_replacement "$title")}"
    result="${result//\{\{content\}\}/$(escape_for_replacement "$html_content")}"
    result="${result//\{\{published\}\}/$(escape_for_replacement "$(format_date_human "$published")")}"
    result="${result//\{\{published_human\}\}/$(escape_for_replacement "$(format_date_human "$published")")}"
    result="${result//\{\{url\}\}/$(escape_for_replacement "$url")}"
    result="${result//\{\{version\}\}/$(escape_for_replacement "$version")}"
    result="${result//\{\{signature_short\}\}/$(escape_for_replacement "$signature_short")}"
    result="${result//\{\{site_url\}\}/$(escape_for_replacement "$POLIS_BASE_URL")}"
    result="${result//\{\{site_title\}\}/$(escape_for_replacement "$site_title")}"
    result="${result//\{\{css_path\}\}/$(escape_for_replacement "$css_path")}"
    result="${result//\{\{home_path\}\}/$(escape_for_replacement "$home_path")}"
    result="${result//\{\{author_name\}\}/$(escape_for_replacement "$author_name")}"
    result="${result//\{\{author_url\}\}/$(escape_for_replacement "$POLIS_BASE_URL")}"
    result="${result//\{\{year\}\}/$(escape_for_replacement "$(date +%Y)")}"
    result="${result//\{\{blessed_count\}\}/$(escape_for_replacement "$blessed_count")}"
    result="${result//\{\{in_reply_to_url\}\}/$(escape_for_replacement "$in_reply_to_url")}"
    result="${result//\{\{root_post_url\}\}/$(escape_for_replacement "$root_post_url")}"

    # Append frontmatter as HTML comment (not full content to avoid duplication)
    # Extract frontmatter fields only (between --- lines, excluding the delimiters)
    local frontmatter_fields=$(echo "$content" | awk '/^---$/{if(++count==2) exit; next} count==1{print}')
    result+="
<!--
=== POLIS SOURCE ===
Source: ${url}
${frontmatter_fields}
=== END POLIS SOURCE ===
-->"

    # Write output (create mount dir if needed)
    mkdir -p "$(dirname "$output_file")"
    echo "$result" > "$output_file"

    # Copy source .md to mount dir (alongside HTML) if mount path differs from source
    if [ -n "$output_md" ]; then
        mkdir -p "$(dirname "$output_md")"
        cp "$input_file" "$output_md"
    fi

    return 0  # Rendered
}

# Render index page
render_index() {
    local posts_list=""
    local post_count=0

    # Read public.jsonl, filter posts, sort by published date descending (latest first)
    if [ -f "$PUBLIC_INDEX" ]; then
        local sorted_posts
        sorted_posts=$(jq -s '[.[] | select(.type == "post" or .type == null)] | sort_by(.published) | reverse' "$PUBLIC_INDEX")

        local num_posts
        num_posts=$(echo "$sorted_posts" | jq 'length')

        for ((i=0; i<num_posts; i++)); do
            local path=$(echo "$sorted_posts" | jq -r ".[$i].path // empty")
            local title=$(echo "$sorted_posts" | jq -r ".[$i].title // \"Untitled\"")
            local published=$(echo "$sorted_posts" | jq -r ".[$i].published // empty")

            [ -z "$path" ] && continue

            # Map source path to mount path for URL
            local mount_path="$path"
            if [ -n "$POSTS_MOUNT_DIR" ]; then
                local path_suffix="${path#$POSTS_DIR/}"
                if [ "$path_suffix" != "$path" ]; then
                    mount_path="${POSTS_MOUNT_DIR}/${path_suffix}"
                fi
            fi
            local html_path="${mount_path%.md}.html"
            local published_human=$(format_date_human "$published")

            posts_list+="            <li><a href=\"$html_path\">$title</a> <time>$published_human</time></li>
"
            ((++post_count))
        done
    fi

    # Get site info - prefer .well-known/polis, fallback to domain
    local site_title=""
    if [ -f "$WELL_KNOWN_DIR/polis" ]; then
        site_title=$(jq -r '.site_title // empty' "$WELL_KNOWN_DIR/polis" 2>/dev/null)
    fi
    if [ -z "$site_title" ]; then
        site_title="${POLIS_BASE_URL#https://}"
        site_title="${site_title#http://}"
    fi

    # Substitute template
    local result="${TEMPLATES[index]}"
    if [ -z "$result" ]; then
        error "Index template is empty. Check $THEMES_DIR/$ACTIVE_THEME/index.html or set active_theme in manifest.json"
    fi

    # Process {{> partial}} includes first
    result=$(render_partials "$result")

    # Process {{#section}}...{{/section}} loops (posts, comments)
    result=$(render_sections "$result")

    # Build view_all_posts link (only shown when more than 10 posts)
    local view_all_posts=""
    if [ "$post_count" -gt 10 ]; then
        view_all_posts="<a href=\"posts/\" class=\"view-all\">View all $post_count posts &rarr;</a>"
    fi

    result="${result//\{\{site_title\}\}/$(escape_for_replacement "$site_title")}"
    result="${result//\{\{site_url\}\}/$(escape_for_replacement "$POLIS_BASE_URL")}"
    result="${result//\{\{posts_list\}\}/$(escape_for_replacement "$posts_list")}"
    result="${result//\{\{post_count\}\}/$(escape_for_replacement "$post_count")}"
    result="${result//\{\{view_all_posts\}\}/$(escape_for_replacement "$view_all_posts")}"
    result="${result//\{\{year\}\}/$(escape_for_replacement "$(date +%Y)")}"

    echo "$result" > "index.html"
    info_human "  Written: index.html"
}

# Render archive page (posts/index.html)
# Lists all posts (unlimited). Only called if theme has posts.html.
render_archive() {
    local post_count=0

    # Get site info
    local site_title=""
    if [ -f "$WELL_KNOWN_DIR/polis" ]; then
        site_title=$(jq -r '.site_title // empty' "$WELL_KNOWN_DIR/polis" 2>/dev/null)
    fi
    if [ -z "$site_title" ]; then
        site_title="${POLIS_BASE_URL#https://}"
        site_title="${site_title#http://}"
    fi

    # Count posts
    if [ -f "$PUBLIC_INDEX" ]; then
        post_count=$(jq -s '[.[] | select(.type == "post" or .type == null)] | length' "$PUBLIC_INDEX" 2>/dev/null) || post_count=0
    fi

    # Substitute template
    local result="${TEMPLATES[archive]}"

    # Process {{> partial}} includes first
    result=$(render_partials "$result")

    # Process {{#section}}...{{/section}} loops (posts)
    result=$(render_sections "$result")

    result="${result//\{\{site_title\}\}/$(escape_for_replacement "$site_title")}"
    result="${result//\{\{site_url\}\}/$(escape_for_replacement "$POLIS_BASE_URL")}"
    result="${result//\{\{post_count\}\}/$(escape_for_replacement "$post_count")}"
    result="${result//\{\{year\}\}/$(escape_for_replacement "$(date +%Y)")}"

    mkdir -p "$POSTS_MOUNT_DIR"
    echo "$result" > "$POSTS_MOUNT_DIR/index.html"
    info_human "  Written: $POSTS_MOUNT_DIR/index.html"
}

# Command: polis render
cmd_render() {
    local force=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --force)
                force=true
                shift
                ;;
            --no-markers)
                RENDER_MARKERS=false
                shift
                ;;
            *)
                json_error "render" "INVALID_INPUT" "Unknown option: $1. Use: polis render [--force] [--no-markers]"
                ;;
        esac
    done

    # Validate .well-known/polis exists and has valid JSON
    validate_wellknown || exit 1

    # Validate POLIS_BASE_URL is set (required for canonical URLs)
    if [ -z "$POLIS_BASE_URL" ]; then
        json_error "render" "MISSING_CONFIG" "POLIS_BASE_URL is not set. Configure it in .env (current directory) or ~/.polis/.env, or set it as an environment variable."
    fi

    # Validate manifest JSON
    validate_manifest || exit 1

    # Check pandoc
    if ! command -v pandoc &>/dev/null; then
        json_error "render" "MISSING_DEPENDENCY" "pandoc is required for rendering. Install with: apt install pandoc (Linux) or brew install pandoc (macOS)"
    fi

    # Ensure active theme is set (select one if not)
    if [ -f "$MANIFEST" ]; then
        local saved_theme
        saved_theme=$(jq -r '.active_theme // empty' "$MANIFEST" 2>/dev/null)
        if [ -z "$saved_theme" ] || [ "$saved_theme" = "null" ]; then
            info_human "No active theme set - selecting theme..."
            select_theme
        fi
    else
        info_human "No manifest found - selecting theme..."
        select_theme
    fi

    # Load theme templates
    load_theme

    info_human "=== Render Configuration ==="
    info_human "Working directory: $(pwd)"
    info_human "POLIS_BASE_URL: $POLIS_BASE_URL"
    info_human "Posts source: $POSTS_DIR"
    info_human "Posts mount: $POSTS_MOUNT_DIR"
    info_human "Comments source: $COMMENTS_DIR"
    info_human "Comments mount: $COMMENTS_MOUNT_DIR"
    info_human "Blessed comments file: $BLESSED_COMMENTS"
    info_human "Active theme: $ACTIVE_THEME"
    info_human "Snippet markers: $RENDER_MARKERS"

    # Show blessed-comments.json summary
    if [ -f "$BLESSED_COMMENTS" ]; then
        local bc_posts=$(jq -r '.comments | length' "$BLESSED_COMMENTS" 2>/dev/null || echo "0")
        info_human "Blessed comments: $bc_posts post(s) with blessed comments"
        if [ "$bc_posts" -gt 0 ]; then
            info_human "Posts with blessed comments:"
            jq -r '.comments[].post' "$BLESSED_COMMENTS" 2>/dev/null | while read -r p; do
                info_human "  - $p"
            done
        fi
    else
        info_human "Blessed comments: file not found"
    fi

    info_human "Theme loaded: $ACTIVE_THEME"

    local posts_rendered=0
    local posts_skipped=0
    local comments_rendered=0
    local comments_skipped=0

    info_human ""
    info_human "=== Rendering Posts ==="

    # Render posts
    if [ -d "$POSTS_DIR" ]; then
        while IFS= read -r post_file; do
            [ -z "$post_file" ] && continue
            info_human "Processing: $post_file"
            if render_file "$post_file" "post" "$force"; then
                ((++posts_rendered))
                info_human "  -> Rendered: ${post_file%.md}.html"
            else
                ((++posts_skipped))
                info_human "  -> Skipped (up to date)"
            fi
        done < <(find "$POSTS_DIR" -name "*.md" -not -path "*/.versions/*" -type f 2>/dev/null)
    else
        info_human "Posts directory not found: $POSTS_DIR"
    fi

    info_human ""
    info_human "=== Rendering Comments ==="

    # Render comments
    if [ -d "$COMMENTS_DIR" ]; then
        while IFS= read -r comment_file; do
            [ -z "$comment_file" ] && continue
            info_human "Processing: $comment_file"
            if render_file "$comment_file" "comment" "$force"; then
                ((++comments_rendered))
                info_human "  -> Rendered: ${comment_file%.md}.html"
            else
                ((++comments_skipped))
                info_human "  -> Skipped (up to date)"
            fi
        done < <(find "$COMMENTS_DIR" -name "*.md" -not -path "*/.versions/*" -type f 2>/dev/null)
    else
        info_human "Comments directory not found: $COMMENTS_DIR"
    fi

    # Copy artifacts to mount dirs
    if [ -n "$COMMENTS_MOUNT_DIR" ] && [ -f "$BLESSED_COMMENTS" ]; then
        mkdir -p "$COMMENTS_MOUNT_DIR"
        cp "$BLESSED_COMMENTS" "$COMMENTS_MOUNT_DIR/blessed.json"
        info_human "Copied blessed.json to $COMMENTS_MOUNT_DIR/"
    fi

    info_human ""
    info_human "=== Generating Index ==="

    # Generate index
    render_index
    info_human "Generated: index.html"

    # Generate archive page (if theme has posts.html)
    if [ -n "${TEMPLATES[archive]:-}" ]; then
        render_archive
        info_human "Generated: posts/index.html"
    fi

    # Regenerate manifest.json
    generate_manifest true

    # Output
    if [ "$JSON_MODE" = true ]; then
        local result=$(jq -n \
            --argjson pr "$posts_rendered" \
            --argjson ps "$posts_skipped" \
            --argjson cr "$comments_rendered" \
            --argjson cs "$comments_skipped" \
            '{posts_rendered: $pr, posts_skipped: $ps, comments_rendered: $cr, comments_skipped: $cs, index_generated: true}')
        json_success "render" "$result"
    else
        echo ""
        success "Rendering complete!"
        info "  Posts rendered: $posts_rendered (skipped: $posts_skipped)"
        info "  Comments rendered: $comments_rendered (skipped: $comments_skipped)"
        info "  Index: index.html"
    fi
}

# Main command router
main() {
    # Parse global --json flag from start OR end of arguments
    # This allows both: polis --json <cmd> AND polis <cmd> [args] --json
    local args=("$@")
    local arg_count=${#args[@]}

    # Check for --json at start
    if [[ $arg_count -gt 0 && "${args[0]}" == "--json" ]]; then
        JSON_MODE=true
        args=("${args[@]:1}")  # Remove first element
        arg_count=${#args[@]}
    fi

    # Check for --json at end (if not already found and array not empty)
    if [[ "$JSON_MODE" != true && $arg_count -gt 0 ]]; then
        local last_idx=$((arg_count - 1))
        if [[ "${args[$last_idx]}" == "--json" ]]; then
            JSON_MODE=true
            unset 'args[last_idx]'  # Remove last element
        fi
    fi

    # Apply JSON mode settings
    if [[ "$JSON_MODE" == true ]]; then
        # Disable colors in JSON mode
        GREEN=''
        BLUE=''
        RED=''
        NC=''
    fi

    # Reconstruct positional parameters
    set -- "${args[@]}"

    local command="${1:-}"
    shift 2>/dev/null || true

    case "$command" in
        init)
            cmd_init "$@"
            ;;
        post)
            cmd_post "$@"
            ;;
        comment)
            cmd_comment "$@"
            ;;
        preview)
            cmd_preview "$@"
