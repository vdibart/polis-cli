# Command: polis rotate-key [--delete-old-key]
# Generate new keypair and re-sign all posts and comments
cmd_rotate_key() {
    local delete_old=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --delete-old-key)
                delete_old=true
                shift
                ;;
            *)
                json_error "rotate-key" "INVALID_INPUT" "Unknown option: $1. Usage: polis rotate-key [--delete-old-key]"
                ;;
        esac
    done

    # Verify initialized
    if [ ! -f "$KEYS_DIR/id_ed25519" ]; then
        json_error "rotate-key" "INVALID_STATE" "Polis not initialized. Run 'polis init' first."
    fi

    if [ ! -f "$WELL_KNOWN_DIR/polis" ]; then
        json_error "rotate-key" "INVALID_STATE" ".well-known/polis not found. Run 'polis init' first."
    fi

    # Read POLIS_BASE_URL for domain
    if [ -z "$POLIS_BASE_URL" ]; then
        json_error "rotate-key" "INVALID_STATE" "POLIS_BASE_URL not set"
    fi
    local domain
    domain=$(extract_domain_from_url "$POLIS_BASE_URL")
    if [ -z "$domain" ]; then
        json_error "rotate-key" "INVALID_STATE" "Could not extract domain from POLIS_BASE_URL"
    fi

    info_human "Starting key rotation..."
    info_human ""

    # Read old public key
    local old_pubkey
    old_pubkey=$(cat "$KEYS_DIR/id_ed25519.pub" 2>/dev/null | tr -d '\n')
    if [ -z "$old_pubkey" ]; then
        json_error "rotate-key" "INVALID_STATE" "Could not read current public key"
    fi

    # 1. Generate new keypair
    info_human "Generating new Ed25519 keypair..."
    ssh-keygen -t ed25519 -f "$KEYS_DIR/id_ed25519.new" -N "" -C "polis@$(hostname)" > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        json_error "rotate-key" "KEY_GENERATION_FAILED" "Failed to generate new keypair"
    fi
    success_human "Generated new keypair"

    local new_pubkey
    new_pubkey=$(cat "$KEYS_DIR/id_ed25519.new.pub" 2>/dev/null | tr -d '\n')

    # 2. Build canonical rotation JSON and sign with OLD key (transition signature)
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

    # Deterministic JSON with sorted keys: action, domain, new_key, old_key, timestamp
    local canonical
    canonical=$(printf '{"action":"key-rotation","domain":"%s","new_key":"%s","old_key":"%s","timestamp":"%s"}' \
        "$domain" "$new_pubkey" "$old_pubkey" "$timestamp")

    info_human "Signing transition message with old key..."
    local temp_file
    temp_file=$(mktemp)
    echo -n "$canonical" > "$temp_file"
    ssh-keygen -Y sign -f "$KEYS_DIR/id_ed25519" -n file "$temp_file" > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        rm -f "$temp_file" "$temp_file.sig"
        json_error "rotate-key" "SIGN_FAILED" "Failed to sign transition message with old key"
    fi
    local transition_sig
    transition_sig=$(cat "$temp_file.sig")
    rm -f "$temp_file" "$temp_file.sig"
    success_human "Signed transition message"

    # 3. Notify DS of key rotation BEFORE local key swap (strict ordering)
    if is_registered_locally; then
        info_human ""
        info_human "Notifying discovery service of key rotation..."
        local ds_url="${DISCOVERY_SERVICE_URL:-https://ds.polis.pub}"
        local ds_payload
        ds_payload=$(jq -cn \
            --arg dom "$domain" \
            --arg old "$old_pubkey" \
            --arg new "$new_pubkey" \
            --arg sig "$transition_sig" \
            --arg ts "$timestamp" \
            '{domain: $dom, old_key: $old, new_key: $new, transition_sig: $sig, timestamp: $ts}')

        local ds_response
        local ds_status
        ds_response=$(curl -s -w "\n%{http_code}" -X POST "${ds_url}/v1/sites/keys/rotate" \
            -H "Content-Type: application/json" \
            ${DISCOVERY_SERVICE_KEY:+-H "Authorization: Bearer $DISCOVERY_SERVICE_KEY"} \
            -d "$ds_payload" 2>/dev/null)
        ds_status=$(echo "$ds_response" | tail -n 1)
        ds_response=$(echo "$ds_response" | sed '$d')

        if [ "$ds_status" -ge 400 ] 2>/dev/null; then
            json_error "rotate-key" "DS_ROTATION_FAILED" "Discovery service rejected key rotation (HTTP $ds_status): $ds_response"
        fi
        success_human "Discovery service acknowledged key rotation"
    else
        info_human ""
        info_human "DS notification skipped: site not registered with discovery service"
    fi

    # 4. Backup old keys
    mv "$KEYS_DIR/id_ed25519" "$KEYS_DIR/id_ed25519.old"
    mv "$KEYS_DIR/id_ed25519.pub" "$KEYS_DIR/id_ed25519.old.pub"

    # 5. Install new key
    mv "$KEYS_DIR/id_ed25519.new" "$KEYS_DIR/id_ed25519"
    mv "$KEYS_DIR/id_ed25519.new.pub" "$KEYS_DIR/id_ed25519.pub"
    success_human "Installed new keypair"

    # 6. Update .well-known/polis
    info_human ""
    info_human "Updating .well-known/polis..."
    if update_wellknown_pubkey; then
        success_human "Updated public key in .well-known/polis"
    else
        warn_human "Failed to update .well-known/polis"
    fi

    # 7. Rebuild index
    info_human ""
    info_human "Rebuilding index..."
    cmd_rebuild --posts > /dev/null 2>&1
    success_human "Rebuilt public.jsonl index"

    # 8. Handle old key
    local old_key_status
    if [ "$delete_old" = true ]; then
        rm -f "$KEYS_DIR/id_ed25519.old" "$KEYS_DIR/id_ed25519.old.pub"
        old_key_status="deleted"
        info_human ""
        info_human "Deleted old keypair"
    else
        old_key_status="archived"
        info_human ""
        info_human "Old keypair archived at $KEYS_DIR/id_ed25519.old"
    fi

    # Get new key fingerprint
    local new_fingerprint=$(ssh-keygen -lf "$KEYS_DIR/id_ed25519.pub" 2>/dev/null | awk '{print $2}')

    # Output results
    info_human ""
    if [ "$JSON_MODE" = true ]; then
        local result=$(jq -n \
            --arg old_key_status "$old_key_status" \
            --arg fingerprint "$new_fingerprint" \
            --arg ds_rotation "success" \
            '{
                old_key: $old_key_status,
                new_key_fingerprint: $fingerprint,
                ds_rotation: $ds_rotation
            }')
        json_success "rotate-key" "$result"
    else
        success "Key rotation complete!"
        info "  New key fingerprint: $new_fingerprint"
        info "  Old content remains verifiable via key history"
        if [ "$old_key_status" = "archived" ]; then
            info "  Old key: archived at $KEYS_DIR/id_ed25519.old"
        else
            info "  Old key: deleted"
        fi
        info ""
        info "  Deploy the updated .well-known/polis file"
    fi
}

# Command: polis unpublish <path>
cmd_unpublish() {
    local post_path="$1"

    # Validate argument
    if [ -z "$post_path" ]; then
        json_error "unpublish" "INVALID_INPUT" "Usage: polis unpublish <path>  Example: polis unpublish content/pub.polis.core/post/20260201/my-post.md"
    fi

    # Validate path is under content/pub.polis.core/post/ (no traversal)
    if [[ "$post_path" != content/pub.polis.core/post/* ]]; then
        json_error "unpublish" "INVALID_INPUT" "Path must start with content/pub.polis.core/post/: $post_path"
    fi
    if [[ "$post_path" == *..* ]]; then
        json_error "unpublish" "INVALID_INPUT" "Path must not contain '..': $post_path"
    fi

    # Verify file exists
    local full_path="$post_path"
    if [ ! -f "$full_path" ]; then
        json_error "unpublish" "NOT_FOUND" "Post not found: $post_path"
    fi

    # Read base URL
    if [ -z "$POLIS_BASE_URL" ]; then
        json_error "unpublish" "INVALID_STATE" "POLIS_BASE_URL not set"
    fi

    # Build content URL: base_url + "/" + post_path (strip .md and re-add)
    local content_path="${post_path%.md}"
    local content_url="${POLIS_BASE_URL%/}/${content_path}.md"

    # Build canonical unregister JSON and sign
    local canonical
    canonical=$(printf '{"type":"pub.polis.post","url":"%s"}' "$content_url")

    local temp_file
    temp_file=$(mktemp)
    echo -n "$canonical" > "$temp_file"
    ssh-keygen -Y sign -f "$KEYS_DIR/id_ed25519" -n file "$temp_file" > /dev/null 2>&1
    local sign_status=$?
    local signature=""
    if [ $sign_status -eq 0 ] && [ -f "$temp_file.sig" ]; then
        signature=$(cat "$temp_file.sig")
    fi
    rm -f "$temp_file" "$temp_file.sig"

    if [ -z "$signature" ]; then
        json_error "unpublish" "SIGN_FAILED" "Failed to sign unregister request"
    fi

    # Call DS to unregister (now does soft-delete) — skip if not registered
    if is_registered_locally; then
        info_human "Removing from discovery service..."
        local ds_url="${DISCOVERY_SERVICE_URL:-https://ds.polis.pub}"
        local ds_payload
        ds_payload=$(jq -cn \
            --arg type "pub.polis.post" \
            --arg url "$content_url" \
            --arg sig "$signature" \
            '{type: $type, url: $url, signature: $sig}')

        local ds_response
        ds_response=$(curl -s -X POST "${ds_url}/v1/content/unregister" \
            -H "Content-Type: application/json" \
            ${DISCOVERY_SERVICE_KEY:+-H "Authorization: Bearer $DISCOVERY_SERVICE_KEY"} \
            -d "$ds_payload" 2>/dev/null)

        # Non-fatal: DS might be unreachable
        if [ -n "$ds_response" ]; then
            success_human "Removed from discovery service"
        else
            warn_human "Warning: could not reach discovery service"
        fi
    else
        info_human "DS unregister skipped: site not registered with discovery service"
    fi

    # Delete local .md file
    rm -f "$full_path"

    # Delete rendered .html file if exists
    local html_path="${full_path%.md}.html"
    rm -f "$html_path" 2>/dev/null

    # Remove from index.jsonl
    local index_file="$PUBLIC_INDEX"
    if [ -f "$index_file" ]; then
        local temp_index
        temp_index=$(mktemp)
        grep -v "\"path\":\"$post_path\"" "$index_file" > "$temp_index" 2>/dev/null || true
        mv "$temp_index" "$index_file"
    fi

    # Remove version history if exists
    local versions_file
    versions_file=$(get_versions_file_path "$post_path")
    rm -f "$versions_file" 2>/dev/null

    # Rebuild manifest
    generate_manifest true > /dev/null 2>&1

    # Output
    if [ "$JSON_MODE" = true ]; then
        local result=$(jq -n \
            --arg path "$post_path" \
            --arg content_url "$content_url" \
            '{path: $path, content_url: $content_url}')
        json_success "unpublish" "$result"
    else
        info_human ""
        success "Post unpublished: $post_path"
    fi
}

# Command: polis extract <file> <hash>
cmd_get_version() {
    local file="$1"
    local target_hash="$2"

    if [ -z "$file" ] || [ -z "$target_hash" ]; then
        error "Usage: polis extract <file> <hash>"
    fi

    if [ ! -f "$file" ]; then
        error "File not found: $file"
    fi

    # Ensure hash has sha256: prefix
    if [[ ! "$target_hash" =~ ^sha256: ]]; then
        target_hash="sha256:$target_hash"
    fi

    info "Reconstructing version $target_hash..."

    # Create temporary output file
    local output=$(mktemp)

    # Reconstruct the version
    reconstruct_version "$file" "$target_hash" "$output"

    # Output to stdout
    cat "$output"

    # Clean up
    rm -f "$output"
}

