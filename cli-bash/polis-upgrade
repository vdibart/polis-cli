#!/usr/bin/env bash
#
# polis-upgrade - Upgrade script for Polis CLI/TUI
#
# Handles version migrations and binary updates via CURL (no git dependency).
# Fetches migration scripts from GitHub (tag-pinned) and verifies them before
# anything runs or is installed. Every download is https-only, including
# redirects.
#
# Trust starts at the release's signature. Each release publishes
# checksums.txt and checksums.txt.sig, an SSH signature by the polis release
# key, whose public half is PINNED below (never fetched). polis-upgrade
# verifies the signature with ssh-keygen, then checks the updated script and
# the migration manifest against checksums.txt, and each migration script
# against the manifest. So a file that verifies was published by whoever
# holds the release key, not merely by whoever could change the repository.
#
# A release made before releases were signed has no checksums.txt.sig.
# polis-upgrade refuses it unless --allow-unsigned is given, and then falls
# back to the .sha256 published beside each script, which proves only that
# the bytes arrived as published (integrity), not who published them.
#
# Usage:
#   polis-upgrade [OPTIONS]
#
# Options:
#   --component cli|tui   Component to upgrade (default: cli)
#   --from VERSION        Override current version detection
#   --to VERSION          Upgrade to specific version (default: latest)
#   --polis-path PATH     Path to polis CLI script (auto-detected if omitted)
#   --site-dir PATH       Path to polis site directory (auto-detected if omitted)
#   --yes                 Skip confirmation prompts
#   --check               Only check for updates, don't apply
#   --allow-unsigned      Accept a release made before releases were signed
#   --help                Show this help message
#
# Dependencies: bash 4.0+, curl, jq, sha256sum/shasum, ssh-keygen (OpenSSH 8.0+)
#

set -euo pipefail

# ============================================================================
# CONSTANTS
# ============================================================================

UPGRADE_VERSION="0.1.0"
GITHUB_REPO="vdibart/polis-cli"
GITHUB_RAW_BASE="https://raw.githubusercontent.com/${GITHUB_REPO}"
GITHUB_RELEASE_BASE="https://github.com/${GITHUB_REPO}/releases/download"

# ⛔ The polis release key, PINNED: a key fetched from where the files come from
# would prove nothing. Generated from release/release-signing-key.pub by
# the release tooling's set-release-key.sh; a test fails if they differ.
RELEASE_SIGNING_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAING2XN2oftAR/Z2d29gQm1vSaTsRyvlTeWt0WxNugooY polis-release"
RELEASE_NAMESPACE="polis-release"

# Set by fetch_signed_checksums to the path of a checksums.txt whose signature
# verified; empty when none did (then only --allow-unsigned proceeds).
RELEASE_CHECKSUMS=""

# Colors
GREEN='\033[0;32m'
CYAN='\033[0;36m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# Disable colors if not a terminal
if [[ ! -t 1 ]]; then
    GREEN='' CYAN='' RED='' YELLOW='' BOLD='' DIM='' NC=''
fi

# ============================================================================
# OUTPUT HELPERS
# ============================================================================

info() {
    echo -e "${CYAN}[i]${NC} $1"
}

success() {
    echo -e "${GREEN}[✓]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[!]${NC} $1" >&2
}

error() {
    echo -e "${RED}[x]${NC} $1" >&2
}

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

# Compare two semantic versions
# Returns: 0 if equal, 1 if a > b, 2 if a < b
compare_versions() {
    local a="$1" b="$2"
    if [[ "$a" == "$b" ]]; then
        return 0
    fi

    local IFS='.'
    local -a a_parts=($a) b_parts=($b)

    for ((i = 0; i < ${#a_parts[@]} || i < ${#b_parts[@]}; i++)); do
        local a_val=${a_parts[$i]:-0}
        local b_val=${b_parts[$i]:-0}
        if ((a_val > b_val)); then
            return 1
        elif ((a_val < b_val)); then
            return 2
        fi
    done
    return 0
}

# Compute SHA-256 hash of a file
compute_sha256() {
    local file="$1"
    if command -v sha256sum &>/dev/null; then
        sha256sum "$file" | awk '{print $1}'
    elif command -v shasum &>/dev/null; then
        shasum -a 256 "$file" | awk '{print $1}'
    else
        error "Neither sha256sum nor shasum found"
        exit 1
    fi
}

# A version is used to build download URLs and is compared arithmetically,
# so accept only plain MAJOR.MINOR.PATCH.
is_valid_version() {
    [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

# Refuse any download URL that is not https://
require_https() {
    local url="$1"
    if [[ "$url" != https://* ]]; then
        error "Refusing to download over a non-https URL: ${url}"
        return 1
    fi
}

# Download a URL to a file over https only, including across redirects.
# Usage: fetch_https URL DEST [MAX_TIME]
fetch_https() {
    local url="$1" dest="$2" max_time="${3:-60}"
    require_https "$url" || return 1
    curl -s -f --proto '=https' --proto-redir '=https' \
        --max-time "$max_time" -L -o "$dest" "$url"
}

# Check a downloaded file against the .sha256 published beside it
# (same URL plus ".sha256", format "<64 hex>  <name>").
#
# This proves the file arrived intact and matches what the release published.
# It does NOT prove who published it: the checksum comes from the same origin
# as the file, so anyone able to change one can change the other.
verify_published_sha256() {
    local file="$1" url="$2"
    local sum_url="${url}.sha256"

    local sum_file
    sum_file=$(mktemp) || return 1
    if ! fetch_https "$sum_url" "$sum_file" 30; then
        error "Could not fetch the published checksum: ${sum_url}"
        rm -f "$sum_file"
        return 1
    fi

    local expected
    expected=$(awk 'NR==1 {print tolower($1)}' "$sum_file")
    rm -f "$sum_file"

    if [[ ! "$expected" =~ ^[0-9a-f]{64}$ ]]; then
        error "The published checksum is malformed: ${sum_url}"
        return 1
    fi

    local actual
    actual=$(compute_sha256 "$file")
    if [[ "$actual" != "$expected" ]]; then
        error "Checksum mismatch for ${url}"
        echo "  Expected: ${expected}" >&2
        echo "  Got:      ${actual}" >&2
        return 1
    fi
    return 0
}

# Fetch a release's checksums.txt and checksums.txt.sig into DIR and verify
# the signature with the pinned key. On success sets RELEASE_CHECKSUMS.
# Returns 3 when the release publishes no signature (one made before releases
# were signed), 1 on any other failure.
# Usage: fetch_signed_checksums TAG DIR
fetch_signed_checksums() {
    local tag="$1" dir="$2"
    local base="${GITHUB_RELEASE_BASE}/v${tag}"
    local typ b64 rest
    read -r typ b64 rest <<<"$RELEASE_SIGNING_KEY"
    if [[ "$typ" != "ssh-ed25519" || -z "$b64" ]]; then
        error "This polis-upgrade has no release key pinned, so it cannot verify a release."
        return 1
    fi
    if ! command -v ssh-keygen &>/dev/null; then
        error "ssh-keygen (OpenSSH 8.0+) is needed to verify the release signature."
        return 1
    fi
    if ! fetch_https "${base}/checksums.txt" "${dir}/checksums.txt" 30; then
        error "Could not fetch the release's checksums.txt: ${base}/checksums.txt"
        return 1
    fi
    if ! fetch_https "${base}/checksums.txt.sig" "${dir}/checksums.txt.sig" 30; then
        return 3
    fi
    printf '%s namespaces="%s" %s %s\n' "$RELEASE_NAMESPACE" "$RELEASE_NAMESPACE" "$typ" "$b64" > "${dir}/allowed_signers"
    if ! ssh-keygen -Y verify -f "${dir}/allowed_signers" -I "$RELEASE_NAMESPACE" -n "$RELEASE_NAMESPACE" \
            -s "${dir}/checksums.txt.sig" < "${dir}/checksums.txt" >/dev/null 2>&1; then
        error "The checksums.txt of v${tag} is not signed by the polis release key. Nothing was changed."
        return 1
    fi
    RELEASE_CHECKSUMS="${dir}/checksums.txt"
    return 0
}

# Check a file against its line in the verified checksums.txt.
# Usage: verify_listed FILE NAME   (NAME as checksums.txt lists it, e.g. cli-bash/polis)
verify_listed() {
    local file="$1" name="$2"
    local expected
    if ! expected=$(awk -v n="$name" 'substr($0, 67) == n { print tolower(substr($0, 1, 64)); c++ } END { exit c != 1 }' "$RELEASE_CHECKSUMS"); then
        error "The release's signed checksums.txt does not list ${name} exactly once"
        return 1
    fi
    local actual
    actual=$(compute_sha256 "$file")
    if [[ "$actual" != "$expected" ]]; then
        error "Checksum mismatch for ${name}: it is not the file the release signed"
        echo "  Expected: ${expected}" >&2
        echo "  Got:      ${actual}" >&2
        return 1
    fi
    return 0
}

# Download a script, verify it, and only then replace the installed copy. It is
# checked against the signed checksums.txt (entry LISTED_NAME) when there is
# one, and against the .sha256 beside it only for an unsigned release the user
# accepted with --allow-unsigned. On any failure the installed file is untouched.
# Usage: install_verified_script URL INSTALL_PATH NAME [LISTED_NAME]
install_verified_script() {
    local url="$1" install_path="$2" name="$3" listed="${4:-cli-bash/$3}"

    require_https "$url" || return 1

    local tmp_file
    tmp_file=$(mktemp) || return 1

    if ! fetch_https "$url" "$tmp_file" 60; then
        error "Failed to download ${name} from ${url}"
        rm -f "$tmp_file"
        return 1
    fi

    local verified=false
    if [[ -n "$RELEASE_CHECKSUMS" ]]; then
        verify_listed "$tmp_file" "$listed" && verified=true
    elif [[ "${ALLOW_UNSIGNED:-false}" == "true" ]]; then
        verify_published_sha256 "$tmp_file" "$url" && verified=true
    else
        error "No verified release signature for ${name}"
    fi
    if [[ "$verified" != "true" ]]; then
        error "Refusing to install ${name}; ${install_path} was not changed"
        rm -f "$tmp_file"
        return 1
    fi

    # Verify it's a valid script
    if ! head -1 "$tmp_file" | grep -q '^#!/'; then
        error "Downloaded file is not a valid script"
        rm -f "$tmp_file"
        return 1
    fi

    # Check if we can write to the install path
    if [[ -f "$install_path" ]] && [[ ! -w "$install_path" ]]; then
        warn "Cannot write to ${install_path} (permission denied)"
        echo "  The verified download is at ${tmp_file}" >&2
        echo "  Try: sudo cp ${tmp_file} ${install_path} && sudo chmod +x ${install_path}" >&2
        return 1
    fi

    cp "$tmp_file" "$install_path"
    chmod +x "$install_path"
    rm -f "$tmp_file"
    return 0
}

# Prompt user for yes/no (default: no)
confirm() {
    local prompt="$1"
    if [[ "${AUTO_YES:-false}" == "true" ]]; then
        return 0
    fi
    echo -en "$prompt ${DIM}[y/N]${NC} "
    read -r reply
    [[ "$reply" =~ ^[Yy]$ ]]
}

# ============================================================================
# RESOLUTION FUNCTIONS
# ============================================================================

# Resolve the site directory
resolve_site_dir() {
    # 1. --site-dir flag (already set)
    if [[ -n "${SITE_DIR:-}" ]]; then
        if [[ ! -d "$SITE_DIR" ]]; then
            error "Site directory does not exist: $SITE_DIR"
            exit 1
        fi
        return 0
    fi

    # 2. POLIS_BASE environment variable
    if [[ -n "${POLIS_BASE:-}" ]] && [[ -d "$POLIS_BASE" ]]; then
        SITE_DIR="$POLIS_BASE"
        return 0
    fi

    # 3. Read from .env in cwd
    if [[ -f ".env" ]]; then
        local base_url
        base_url=$(grep -E '^POLIS_BASE_URL=' .env 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'")
        if [[ -n "$base_url" ]]; then
            # If .env exists here, cwd is likely the site dir
            SITE_DIR="$(pwd)"
            return 0
        fi
    fi

    # 4. Check if cwd contains .well-known/polis
    if [[ -f ".well-known/polis" ]]; then
        SITE_DIR="$(pwd)"
        return 0
    fi

    error "Could not determine site directory."
    echo "  Set POLIS_BASE, use --site-dir, or run from your polis site directory." >&2
    exit 1
}

# Resolve the polis CLI script path
resolve_polis_path() {
    # 1. --polis-path flag (already set)
    if [[ -n "${POLIS_PATH:-}" ]]; then
        if [[ ! -f "$POLIS_PATH" ]]; then
            error "Polis script not found at: $POLIS_PATH"
            exit 1
        fi
        return 0
    fi

    # 2. Check site directory (typical setup: CLI lives alongside content)
    if [[ -n "${SITE_DIR:-}" ]] && [[ -f "${SITE_DIR}/polis" ]]; then
        POLIS_PATH="${SITE_DIR}/polis"
        return 0
    fi

    # 3. Fall back to which
    if command -v polis &>/dev/null; then
        POLIS_PATH="$(command -v polis)"
        return 0
    fi

    error "Could not locate polis CLI script."
    echo "  Use --polis-path or ensure 'polis' is in your PATH." >&2
    exit 1
}

# Read VERSION constant from polis script
read_polis_version() {
    local script="$1"
    grep -E '^VERSION="[0-9]+\.[0-9]+\.[0-9]+"' "$script" 2>/dev/null \
        | head -1 \
        | sed 's/VERSION="//;s/"//'
}

# ============================================================================
# LATEST VERSION
# ============================================================================

# Print the version of the latest published release of polis-cli (the tag
# vMAJOR.MINOR.PATCH, without the "v"). The release is the source of truth:
# the scripts and manifests this tool downloads are pinned to its tag.
# Usage: latest_release_version COMPONENT
latest_release_version() {
    local component="$1"

    # A release tag carries the CLI's version, not the TUI's.
    if [[ "$component" != "cli" ]]; then
        error "Cannot determine the latest ${component} version automatically."
        echo "  Pass the version to upgrade to with --to VERSION." >&2
        return 1
    fi

    local api_url="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"
    local body
    body=$(mktemp) || return 1
    if ! fetch_https "$api_url" "$body" 15; then
        rm -f "$body"
        error "Could not reach GitHub to find the latest release: ${api_url}"
        echo "  Check your connection, or pass the version with --to VERSION." >&2
        return 1
    fi

    local tag
    tag=$(jq -r '.tag_name // empty' "$body" 2>/dev/null || true)
    rm -f "$body"

    local version="${tag#v}"
    if [[ "$tag" != v* ]] || ! is_valid_version "$version"; then
        error "The latest release has an unexpected tag: '${tag}'"
        echo "  Pass the version to upgrade to with --to VERSION." >&2
        return 1
    fi
    echo "$version"
}

# ============================================================================
# MIGRATION FUNCTIONS
# ============================================================================

# Fetch manifest from GitHub (tag-pinned)
fetch_manifest() {
    local component="$1"
    local tag="$2"

    local manifest_url="${GITHUB_RAW_BASE}/v${tag}/migrations/${component}/manifest.json"

    require_https "$manifest_url" || exit 1

    # Downloaded to a file, not captured, so the bytes hashed are the bytes served.
    local manifest_file
    manifest_file=$(mktemp) || exit 1
    if ! fetch_https "$manifest_url" "$manifest_file" 15; then
        rm -f "$manifest_file"
        error "Failed to fetch migration manifest from: $manifest_url"
        echo "  Ensure the tag v${tag} exists on GitHub." >&2
        exit 1
    fi
    # ⛔ The manifest carries every migration script's checksum, so it is checked
    # against the signed checksums.txt first (an unsigned release only with
    # --allow-unsigned, which the caller has already decided).
    if [[ -n "$RELEASE_CHECKSUMS" ]] && ! verify_listed "$manifest_file" "migrations/${component}/manifest.json"; then
        rm -f "$manifest_file"
        error "Refusing the migration manifest of v${tag}"
        exit 1
    fi
    local response
    response=$(cat "$manifest_file")
    rm -f "$manifest_file"

    if [[ -z "$response" ]] || echo "$response" | jq -e '.message' &>/dev/null 2>&1; then
        error "Failed to fetch migration manifest from: $manifest_url"
        echo "  Ensure the tag v${tag} exists on GitHub." >&2
        exit 1
    fi

    # Validate it's valid JSON with expected structure
    if ! echo "$response" | jq -e '.component' &>/dev/null; then
        error "Invalid manifest format (missing 'component' field)"
        exit 1
    fi

    echo "$response"
}

# Filter applicable migrations from manifest
filter_migrations() {
    local manifest="$1"
    local from_version="$2"
    local to_version="$3"

    # Use jq to filter and sort migrations
    echo "$manifest" | jq -c --arg from "$from_version" --arg to "$to_version" '
        .migrations
        | map(select(
            # from >= current_version (migration applies to users at or above this version)
            (.from | split(".") | map(tonumber)) as $mfrom |
            ($from | split(".") | map(tonumber)) as $cfrom |
            # to <= target_version
            (.to | split(".") | map(tonumber)) as $mto |
            ($to | split(".") | map(tonumber)) as $cto |
            # Compare: migration.from >= current
            (
                ($mfrom[0] > $cfrom[0]) or
                ($mfrom[0] == $cfrom[0] and $mfrom[1] > $cfrom[1]) or
                ($mfrom[0] == $cfrom[0] and $mfrom[1] == $cfrom[1] and $mfrom[2] >= $cfrom[2])
            ) and
            # Compare: migration.to <= target
            (
                ($mto[0] < $cto[0]) or
                ($mto[0] == $cto[0] and $mto[1] < $cto[1]) or
                ($mto[0] == $cto[0] and $mto[1] == $cto[1] and $mto[2] <= $cto[2])
            )
        ))
        | sort_by(.from | split(".") | map(tonumber))
    '
}

# Download and verify a migration script
download_migration() {
    local component="$1"
    local tag="$2"
    local script_name="$3"
    local expected_sha256="$4"
    local dest="$5"

    local script_url="${GITHUB_RAW_BASE}/v${tag}/migrations/${component}/${script_name}"

    if ! fetch_https "$script_url" "$dest" 30; then
        error "Failed to download migration script: $script_name"
        return 1
    fi

    # Verify checksum
    local actual_sha256
    actual_sha256=$(compute_sha256 "$dest")

    if [[ "$actual_sha256" != "$expected_sha256" ]]; then
        error "Checksum verification failed for ${script_name}"
        echo "  Expected: ${expected_sha256}" >&2
        echo "  Got:      ${actual_sha256}" >&2
        rm -f "$dest"
        return 1
    fi

    chmod +x "$dest"
    return 0
}

# ============================================================================
# MAIN WORKFLOW
# ============================================================================

show_help() {
    echo "polis-upgrade ${UPGRADE_VERSION} - Upgrade Polis CLI/TUI"
    echo ""
    echo "Usage: polis-upgrade [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --component cli|tui   Component to upgrade (default: cli)"
    echo "  --from VERSION        Override current version detection"
    echo "  --to VERSION          Upgrade to specific version (default: latest)"
    echo "  --polis-path PATH     Path to polis CLI script"
    echo "  --site-dir PATH       Path to polis site directory"
    echo "  --yes                 Skip confirmation prompts"
    echo "  --check               Only check for updates, don't apply"
    echo "  --allow-unsigned      Accept a release made before releases were signed"
    echo "  --help                Show this help message"
    echo ""
    echo "Examples:"
    echo "  polis-upgrade                      # Upgrade CLI to latest"
    echo "  polis-upgrade --to 0.39.0          # Upgrade CLI to specific version"
    echo "  polis-upgrade --component tui --to 0.40.0  # Upgrade TUI (needs --to)"
    echo "  polis-upgrade --check              # Check what's available"
    echo "  polis-upgrade --from 0.33.0        # Override version detection"
}

main() {
    # Parse arguments
    local COMPONENT="cli"
    local FROM_VERSION=""
    local TO_VERSION=""
    local POLIS_PATH=""
    local SITE_DIR=""
    local AUTO_YES="false"
    local CHECK_ONLY="false"
    local ALLOW_UNSIGNED="false"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --component)
                COMPONENT="$2"
                if [[ "$COMPONENT" != "cli" && "$COMPONENT" != "tui" ]]; then
                    error "Invalid component: $COMPONENT (must be 'cli' or 'tui')"
                    exit 1
                fi
                shift 2
                ;;
            --from)
                FROM_VERSION="$2"
                shift 2
                ;;
            --to)
                TO_VERSION="$2"
                shift 2
                ;;
            --polis-path)
                POLIS_PATH="$2"
                shift 2
                ;;
            --site-dir)
                SITE_DIR="$2"
                shift 2
                ;;
            --yes|-y)
                AUTO_YES="true"
                shift
                ;;
            --allow-unsigned)
                ALLOW_UNSIGNED="true"
                shift
                ;;
            --check)
                CHECK_ONLY="true"
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            --version)
                echo "polis-upgrade ${UPGRADE_VERSION}"
                exit 0
                ;;
            *)
                error "Unknown option: $1"
                echo "Run 'polis-upgrade --help' for usage." >&2
                exit 1
                ;;
        esac
    done

    # Export for use in functions
    export AUTO_YES SITE_DIR POLIS_PATH ALLOW_UNSIGNED

    echo -e "${BOLD}${CYAN}polis-upgrade${NC} ${DIM}v${UPGRADE_VERSION}${NC}"
    echo ""

    # Step 1: Resolve site directory
    resolve_site_dir

    # Step 2: Resolve polis CLI path and determine current version
    if [[ -z "$FROM_VERSION" ]]; then
        resolve_polis_path

        local detected_version
        if [[ "$COMPONENT" == "cli" ]]; then
            detected_version=$(read_polis_version "$POLIS_PATH")
        else
            # For TUI, look for polis-tui in the same directory
            local tui_path="${POLIS_PATH%polis}polis-tui"
            if [[ -f "$tui_path" ]]; then
                detected_version=$(grep -E '^TUI_VERSION="[0-9]+\.[0-9]+\.[0-9]+"' "$tui_path" 2>/dev/null \
                    | head -1 | sed 's/TUI_VERSION="//;s/"//')
            fi
        fi

        if [[ -z "${detected_version:-}" ]]; then
            error "Could not detect current ${COMPONENT} version from ${POLIS_PATH}"
            echo "  Use --from VERSION to specify manually." >&2
            exit 1
        fi

        FROM_VERSION="$detected_version"
        info "Detected current ${COMPONENT} version: ${FROM_VERSION}"
    else
        info "Using specified version: ${FROM_VERSION}"
    fi

    # Step 3: Determine target version
    if [[ -z "$TO_VERSION" ]]; then
        info "Checking latest ${COMPONENT} version..."
        TO_VERSION=$(latest_release_version "$COMPONENT") || exit 1

        info "Latest ${COMPONENT} version: ${TO_VERSION}"
    else
        info "Target version: ${TO_VERSION}"
    fi

    # Both versions are compared arithmetically and the target is used to
    # build the pinned download URLs, so accept only MAJOR.MINOR.PATCH.
    if ! is_valid_version "$FROM_VERSION"; then
        error "Invalid current version: ${FROM_VERSION} (expected MAJOR.MINOR.PATCH)"
        exit 1
    fi
    if ! is_valid_version "$TO_VERSION"; then
        error "Invalid target version: ${TO_VERSION} (expected MAJOR.MINOR.PATCH)"
        exit 1
    fi

    # Only move forward. compare_versions returns 1 when TO > FROM.
    local cmp=0
    compare_versions "$TO_VERSION" "$FROM_VERSION" || cmp=$?
    if [[ "$cmp" -ne 1 ]]; then
        success "${COMPONENT} is already at or above ${TO_VERSION}"
        exit 0
    fi

    echo ""

    # One working directory for everything downloaded, removed on exit.
    local tmp_dir
    tmp_dir=$(mktemp -d)
    trap "rm -rf '$tmp_dir'" EXIT

    # Step 4: verify the release's signature. Everything after trusts only what
    # the signed checksums.txt names.
    info "Verifying the release signature..."
    local sig_rc=0
    fetch_signed_checksums "$TO_VERSION" "$tmp_dir" || sig_rc=$?
    if [[ "$sig_rc" -eq 0 ]]; then
        success "v${TO_VERSION} is signed by the polis release key"
    elif [[ "$sig_rc" -eq 3 && "$ALLOW_UNSIGNED" == "true" ]]; then
        warn "v${TO_VERSION} predates signed releases. With --allow-unsigned, each file is checked only against"
        warn "the .sha256 published beside it, which proves it arrived intact, not who published it."
    elif [[ "$sig_rc" -eq 3 ]]; then
        error "v${TO_VERSION} has no release signature (checksums.txt.sig): it predates signed releases."
        echo "  Upgrade to the latest release instead, or pass --allow-unsigned to accept it" >&2
        echo "  with only the unsigned .sha256 checks." >&2
        exit 1
    else
        exit 1
    fi
    echo ""

    # Step 5: Fetch manifest and identify migrations
    info "Fetching migration manifest..."
    local manifest
    manifest=$(fetch_manifest "$COMPONENT" "$TO_VERSION")

    local migrations
    migrations=$(filter_migrations "$manifest" "$FROM_VERSION" "$TO_VERSION")

    local migration_count
    migration_count=$(echo "$migrations" | jq 'length')

    if [[ "$migration_count" -eq 0 ]]; then
        info "No migrations needed between ${FROM_VERSION} and ${TO_VERSION}"
    else
        echo -e "Migrations to apply (${BOLD}${migration_count}${NC} version jumps require changes):"
        echo ""

        local i=1
        echo "$migrations" | jq -r '.[] | "  \(.from) -> \(.to): \(.description)"' | while read -r line; do
            echo -e "  ${CYAN}${i}.${NC} v${line}"
            ((i++)) || true
        done

        echo ""
    fi

    # Check-only mode stops here
    if [[ "$CHECK_ONLY" == "true" ]]; then
        if [[ "$migration_count" -gt 0 ]]; then
            echo "Run without --check to apply these migrations."
        fi
        exit 0
    fi

    # Step 6: Apply migrations
    if [[ "$migration_count" -gt 0 ]]; then
        if ! confirm "Proceed with migrations?"; then
            info "Upgrade cancelled."
            exit 0
        fi

        echo ""

        # Download and verify all scripts first
        info "Downloading and verifying migration scripts..."
        local idx=0
        local script_paths=()
        local script_froms=()

        while IFS= read -r migration; do
            local script_name from_ver sha256
            script_name=$(echo "$migration" | jq -r '.script')
            from_ver=$(echo "$migration" | jq -r '.from')
            sha256=$(echo "$migration" | jq -r '.sha256')

            # The name becomes a local path and part of a URL: a bare file
            # name only.
            if [[ ! "$script_name" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
                error "Invalid migration script name in manifest: ${script_name}"
                exit 1
            fi

            local dest="${tmp_dir}/${script_name}"
            if ! download_migration "$COMPONENT" "$TO_VERSION" "$script_name" "$sha256" "$dest"; then
                error "Aborting upgrade - checksum verification failed"
                exit 1
            fi

            script_paths+=("$dest")
            script_froms+=("$from_ver")
            ((idx++)) || true
        done < <(echo "$migrations" | jq -c '.[]')

        success "All scripts verified"
        echo ""

        # Execute scripts in sequence
        for ((i = 0; i < ${#script_paths[@]}; i++)); do
            local script="${script_paths[$i]}"
            local script_basename
            script_basename=$(basename "$script")
            local from_v="${script_froms[$i]}"

            echo -e "${BOLD}Running migration ${script_basename}...${NC}"

            # Execute with POLIS_BASE set
            if ! POLIS_BASE="$SITE_DIR" bash "$script"; then
                echo ""
                error "Migration failed: ${script_basename}"

                # Determine next version for recovery
                if ((i + 1 < ${#script_froms[@]})); then
                    local next_from="${script_froms[$((i + 1))]}"
                    echo "  To resume after fixing the issue:" >&2
                    echo "    polis-upgrade --from ${next_from} --to ${TO_VERSION}" >&2
                else
                    echo "  This was the last migration. Fix the issue and re-run:" >&2
                    echo "    polis-upgrade --from ${from_v} --to ${TO_VERSION}" >&2
                fi
                exit 1
            fi

            echo ""
        done

        success "All migrations complete."
        echo ""
    fi

    # Step 7: Offer to download updated binary
    local binary_name="polis"
    if [[ "$COMPONENT" == "tui" ]]; then
        binary_name="polis-tui"
    fi

    local install_path="${POLIS_PATH:-${SITE_DIR}/${binary_name}}"
    local download_url="${GITHUB_RAW_BASE}/v${TO_VERSION}/cli-bash/${binary_name}"

    echo -e "Download updated ${COMPONENT} (v${TO_VERSION}) to ${DIM}${install_path}${NC}?"
    if confirm "Proceed?"; then
        if ! install_verified_script "$download_url" "$install_path" "$binary_name"; then
            error "Did not install ${binary_name} v${TO_VERSION}"
            exit 1
        fi
        success "Downloaded and verified ${binary_name} v${TO_VERSION}"
    fi

    echo ""
    success "Upgrade complete!"
}

# Run only when executed, so the functions above can be sourced by tests.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
